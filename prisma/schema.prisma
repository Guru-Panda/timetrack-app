generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id         String   @id @default(uuid())
  name       String
  timezone   String   @default("Europe/London")
  created_at DateTime @default(now())

  profiles     Profile[]
  projects     Project[]
  clients      Client[]
  time_entries TimeEntry[]
  invites      Invite[]
  invoices     Invoice[]
  tags         Tag[]
  leave_policies LeavePolicy[]
  leave_requests LeaveRequest[]
  leave_balances LeaveBalance[]
  integrations Integration[]
  actions      Action[]

  @@map("organizations")
}

model Profile {
  id          String   @id @default(uuid())
  user_id     String   @unique
  full_name   String
  avatar_url  String?
  org_id      String
  role        String   @default("member")
  hourly_rate Float?
  timezone    String   @default("Europe/London")
  created_at  DateTime @default(now())

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  time_entries TimeEntry[]
  leave_requests LeaveRequest[] @relation("LeaveOwner")
  leave_reviews  LeaveRequest[] @relation("LeaveReviewer")
  leave_balances LeaveBalance[]
  assigned_actions Action[] @relation("ActionAssignee")

  @@map("profiles")
}

model Client {
  id         String   @id @default(uuid())
  org_id     String
  name       String
  color      String   @default("#3b82f6")
  created_at DateTime @default(now())

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  projects     Project[]
  invoices     Invoice[]

  @@map("clients")
}

model Project {
  id          String   @id @default(uuid())
  org_id      String
  client_id   String?
  name        String
  color       String   @default("#8b5cf6")
  is_billable Boolean  @default(true)
  is_archived Boolean  @default(false)
  created_at  DateTime @default(now())

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [client_id], references: [id], onDelete: SetNull)
  time_entries TimeEntry[]
  actions      Action[]

  @@map("projects")
}

model TimeEntry {
  id          String    @id @default(uuid())
  user_id     String
  org_id      String
  project_id  String?
  description String    @default("")
  start_time  DateTime
  end_time    DateTime?
  duration    Int?
  is_billable Boolean   @default(true)
  is_running  Boolean   @default(false)
  created_at  DateTime  @default(now())

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [project_id], references: [id], onDelete: SetNull)
  profile      Profile      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("time_entries")
}

model Tag {
  id         String   @id @default(uuid())
  org_id     String
  name       String
  color      String   @default("#6366f1")
  created_at DateTime @default(now())

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@map("tags")
}

model Invite {
  id         String   @id @default(uuid())
  org_id     String
  email      String
  role       String   @default("member")
  token      String   @unique @default(uuid())
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@map("invites")
}

model Invoice {
  id             String   @id @default(uuid())
  org_id         String
  client_id      String
  invoice_number String
  status         String   @default("draft")
  issue_date     DateTime
  due_date       DateTime
  total_amount   Float    @default(0)
  currency       String   @default("GBP")
  notes          String?
  created_at     DateTime @default(now())

  organization Organization  @relation(fields: [org_id], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [client_id], references: [id], onDelete: Cascade)
  items        InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id          String @id @default(uuid())
  invoice_id  String
  description String
  hours       Float
  rate        Float
  amount      Float

  invoice Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model LeavePolicy {
  id             String   @id @default(uuid())
  org_id         String
  name           String
  leave_type     String
  annual_quota   Float    @default(0)
  allow_half_day Boolean  @default(true)
  carry_forward  Boolean  @default(false)
  color          String   @default("#8b5cf6")
  created_at     DateTime @default(now())

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  balances     LeaveBalance[]
  requests     LeaveRequest[]

  @@map("leave_policies")
}

model LeaveBalance {
  id         String   @id @default(uuid())
  org_id     String
  user_id    String
  policy_id  String
  year       Int
  used       Float    @default(0)
  allocated  Float    @default(0)
  updated_at DateTime @default(now()) @updatedAt

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  profile      Profile      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  policy       LeavePolicy  @relation(fields: [policy_id], references: [id], onDelete: Cascade)

  @@unique([user_id, policy_id, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id               String    @id @default(uuid())
  org_id           String
  user_id          String
  policy_id        String
  start_date       DateTime  @db.Date
  end_date         DateTime  @db.Date
  is_half_day      Boolean   @default(false)
  half_day_period  String?
  days_count       Float     @default(1)
  reason           String    @default("")
  status           String    @default("pending")
  reviewer_id      String?
  reviewed_at      DateTime?
  review_note      String?
  hive_action_id   String?
  created_at       DateTime  @default(now())

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  profile      Profile      @relation("LeaveOwner", fields: [user_id], references: [user_id], onDelete: Cascade)
  reviewer     Profile?     @relation("LeaveReviewer", fields: [reviewer_id], references: [user_id], onDelete: SetNull)
  policy       LeavePolicy  @relation(fields: [policy_id], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

model Integration {
  id           String   @id @default(uuid())
  org_id       String
  provider     String
  api_key      String?
  external_id  String?
  workspace_id String?
  config       Json?
  enabled      Boolean  @default(true)
  last_sync_at DateTime?
  created_at   DateTime @default(now())

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@unique([org_id, provider])
  @@map("integrations")
}

model Action {
  id             String    @id @default(uuid())
  org_id         String
  project_id     String?
  assignee_id    String?
  title          String
  description    String    @default("")
  status         String    @default("unstarted")
  due_date       DateTime?
  hive_action_id String?
  position       Float     @default(0)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @default(now()) @updatedAt

  organization Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [project_id], references: [id], onDelete: SetNull)
  assignee     Profile?     @relation("ActionAssignee", fields: [assignee_id], references: [user_id], onDelete: SetNull)

  @@map("actions")
}

